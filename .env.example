# ============================================================
# AppSentinel Environment Configuration
# Copy this file to .env and fill in your keys
# ============================================================

# --- Server ---
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
FRONTEND_ORIGIN=http://localhost:8088
CORS_ORIGINS=http://localhost:8088,http://localhost:3000

# --- Database ---
DATABASE_URL=sqlite:///./storage/appsentinel.db

# --- External API Keys & Engines (graceful fallback if missing) ---
VIRUSTOTAL_API_KEY=
URLSCAN_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
GEMINI_API_KEY=your-gemini-api-key-here
AI_MODEL=gemini-2.5-flash

# --- MobSF & Static APK Analysis ---
# MobSF runs via Docker (see docker/docker-compose.yml)
# If the backend runs in the root docker-compose.yml, use MOBSF_URL=http://mobsf:8000.
# GitHub: https://github.com/MobSF/Mobile-Security-Framework-MobSF
# IMPORTANT: Docker Compose has a local-demo fallback key so MobSF can boot even
# when this is blank. Set a strong, unique value before any public deployment.
MOBSF_URL=http://localhost:8001
MOBSF_API_KEY=change-me-to-a-strong-random-key
MOBSF_PORT=8001
# Note: Androguard runs locally inside the Python backend and does not require an external API key.

# --- Upload Limits ---
MAX_APK_SIZE_MB=50
UPLOAD_DIR=./storage/uploads

# --- Logging ---
LOG_LEVEL=INFO
