# ============================================================
# AppSentinel .gitignore
# ============================================================

# Environment & secrets
.env
.env.local
.env.*.local
.appdeploy

# Python bytecode & caches
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Pytest caches
.pytest_cache/
htmlcov/
.coverage
*.cover

# Virtual environments
venv/
.venv/
env/
ENV/

# Local databases and runtime storage
*.db
*.sqlite
*.sqlite3
storage/*
!storage/.gitkeep
storage/appsentinel.db

# Generated reports
storage/reports/

# Uploaded APKs (user-submitted files must never be committed)
storage/uploads/

# Local MobSF runtime data if mounted into the project during development
storage/mobsf/
.MobSF/

# IDE & editor files
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Kombai (generated)
.kombai/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg

# Node (if any frontend build tooling is added later)
node_modules/
